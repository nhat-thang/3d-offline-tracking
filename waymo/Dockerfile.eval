# Moi truong cham diem Waymo (CPU): bo cham chinh thuc dang Python + gdown de tai file cua CTRL.
# Goi waymo-open-dataset doi jaxlib==0.4.13 (PyPI khong con), nen cai --no-deps roi cai phan phu thuoc can cho phan metrics.
FROM python:3.10-slim
RUN pip install --no-cache-dir --no-deps waymo-open-dataset-tf-2-12-0==1.6.7 \
 && pip install --no-cache-dir tensorflow-cpu==2.13.1 numpy==1.23.5 pandas==1.5.3 pyarrow==16.0.0 \
      immutabledict==2.2.0 absl-py dacite==1.8.1 gdown==6.5.2
# Them cho phan doc du lieu v2 (lidar, pose) cua waymo_open_dataset.v2
RUN pip install --no-cache-dir "dask[dataframe]==2023.3.1" scikit-learn==1.2.2
WORKDIR /repro
